# --- API ---
# Obligatoria. Genérala con: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Postgres ---
POSTGRES_USER=riesgos
POSTGRES_PASSWORD=riesgos
POSTGRES_DB=riesgos
DATABASE_URL=postgresql+psycopg://riesgos:riesgos@db:5432/riesgos

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Almacenamiento de archivos ---
STORAGE_DIR=/data/contratos

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- OCR ---
OCR_LANG=spa
OCR_MIN_CHARS_PER_PAGE=100
